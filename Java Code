		saveData.writeData(Cyndaquil.getFilePath());
		saveData.saveGameData(Cyndaquil.getFilePath(), Cyndaquil.getPokedexNum(), Cyndaquil.getPokemonName());
	}
	/*
	 * getters to use these values in controller classes
	 */
	public static int getEncounterCount() {
	    return encounterCount;
	}
	public static double getProbabilityMessage() {
	    return probabilityMessage;
	}
	public static void addEncounter() {
	    encounterCount++;
	}
