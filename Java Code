public class controller {
/**
 * FXML variables to be used in the controller class
 */
	@FXML
	private Stage stage;
	@FXML
	private Scene scene;
	@FXML
	private Parent root;
	@FXML
	private TextField textField;
	@FXML
	private Button myButton;
	@FXML
	private Button exitButton;
	@FXML
	private Pane mainPane;
	/**
	 * Open the text file and switch the pane to begin the hunt displaying the data
	 * from saveData
	 */
	public void start(ActionEvent e) throws IOException {
		try {

			String input = textField.getText();

			if (!input.equalsIgnoreCase("Cyndaquil") && !input.equalsIgnoreCase("Chikorita")
					&& !input.equalsIgnoreCase("Totodile")) {

				System.out.println("Invalid Pokemon");
				return;
			}

			FXMLLoader loader = new FXMLLoader(getClass().getResource("select.fxml"));

			root = loader.load();

			controlScene2 scene2Controller = loader.getController();

			scene2Controller.setPokemon(input);
			stage = (Stage) ((Node) e.getSource()).getScene().getWindow();
			scene = new Scene(root);
			stage.setScene(scene);
			stage.show();

		} catch (Exception exception) {
			exception.printStackTrace();
		}
	}
	/**
	 * Closes the window when done with the program
	 */
	public void logout(ActionEvent e) {

		stage = (Stage) mainPane.getScene().getWindow();
		stage.close();

	}
}
