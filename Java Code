import java.io.BufferedReader;
import java.io.FileNotFoundException;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class saveData {

	private static int encounterCount = 0;
	private static double probabilityMessage = 0.0;
/**
 * checkData is called later to read the text files used to save the hunt data 
 * for later.
 */
	public static void checkData(String filePath) {

		try (BufferedReader reader = new BufferedReader(new FileReader(filePath))) {

			String line;
			while ((line = reader.readLine()) != null) {
				if (line.startsWith("Encounters:")) {
					String value = line.replace("Encounters:", "").trim();
					encounterCount = Integer.parseInt(value);
				} else if (line.startsWith("Probability:")) {
					String value = line.replace("Probability:", "").replace("%", "").trim();
					probabilityMessage = Double.parseDouble(value);
				}
			}

		} catch (FileNotFoundException e) {
			encounterCount = 0;
			probabilityMessage = 0.0;
		} catch (IOException e) {
			System.out.println("There was a problem reading the save file");
		}
	}
/*
 * read data using the buffered reader 
 */
	public static void readData(String filePath) {

		try (BufferedReader reader = new BufferedReader(new FileReader(filePath))) {
			String line;
			System.out.println("------Current save data-------\n");
			while ((line = reader.readLine()) != null) {
				System.out.println(line);
			}

		} catch (FileNotFoundException e) {
			System.out.println("No previous save starting new hunt");
		} catch (IOException e) {
			System.out.println("There was a problem reading your previous save data");
		}
	}

	public static void writeData(String filePath) {
		Scanner inputScanner = new Scanner(System.in);
		System.out.println("Hit enter for each encounter or type End to finish");
		while (true) {
			String input = inputScanner.nextLine();
			if (input.isEmpty()) {
				encounterCount++;
				continue;
			}
			if (input.equalsIgnoreCase("end")) {
				System.out.print("Ending session....");
				break;
			}if(input.equalsIgnoreCase("Reset")) {
				encounterCount = 0;
				probabilityMessage = 0.0;
			} else {
				System.out.print("Not valid try again");
				continue;
			}
		}
		inputScanner.close();
	}
/*
 * save data sets the values used by the specific pokemon's static void
 */
	public static void saveGameData(String filePath, int pokedexNum, String pokemonName) {
		try (FileWriter writer = new FileWriter(filePath)) {
			probabilityMessage = (1 - Math.pow((8191.0 / 8192.0), encounterCount)) * 100;

			writer.write(pokedexNum + "\n" + pokemonName + "\nEncounters:" + encounterCount + "\nProbability: "
					+ String.format("%.2f", probabilityMessage) + " %\n");
		} catch (IOException e) {
			System.out.println("There was a problem saving your file");
		}
	}
/*
 * individual method for each pokemon which interacts with shakingGrass class
 * to get the specific file path and get the saved variables saved.
 */
	public static void Totodile() {
		shakingGrass Totodile = new shakingGrass("Path", 0, "Totodile");
		Totodile.setFilePath("totodile.txt");
		Totodile.setPokedexNum(158);
		Totodile.setPokemonName("Totodile");
		System.out.println("You chose " + Totodile.getPokemonName());
		saveData.checkData(Totodile.getFilePath());
		saveData.readData(Totodile.getFilePath());
		saveData.writeData(Totodile.getFilePath());
		saveData.saveGameData(Totodile.getFilePath(), Totodile.getPokedexNum(), Totodile.getPokemonName());
	}
	public static void chikorita() {
		shakingGrass Chikorita = new shakingGrass("Path" , 0 , "Chikorita");
		Chikorita.setFilePath("chikorita.txt");
		Chikorita.setPokedexNum(152);
		Chikorita.setPokemonName("Chikorita");
		System.out.println("You chose " + Chikorita.getPokemonName());
		saveData.checkData(Chikorita.getFilePath());
		saveData.readData(Chikorita.getFilePath());
		saveData.writeData(Chikorita.getFilePath());
		saveData.saveGameData(Chikorita.getFilePath(), Chikorita.getPokedexNum(), Chikorita.getPokemonName());
	}
	public static void cyndaquil() {
		shakingGrass Cyndaquil = new shakingGrass("Path", 0 , "Cyndaquil");
		Cyndaquil.setFilePath("cyndaquil.txt");
		Cyndaquil.setPokedexNum(155);
