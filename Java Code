public class controlScene2 {
	/**
	 * Names the labels and buttons used on the second page of the app to be used
	 * later in the later classes and as a part of the select.fxml
	 */
	@FXML
	private Label pokemonLabel;

	@FXML
	private Label encounterLabel;

	@FXML
	private Label probabilityLabel;

	@FXML
	private Button huntButton;
	/**
	 * variables to be called later
	 */
	private String pokemonName;
	private String filePath;
	private int pokedexNum;

	/**
	 * sets the variable pokemonName and initiates loadPokemonData which calls the
	 * data stored from the class saveData and displays that data using the FXML
	 * labels
	 */
	public void setPokemon(String pokemonName) {
		this.pokemonName = pokemonName;

		System.out.println("Selected Pokemon: " + pokemonName);

		loadPokemonData();
	}
    @FXML
    public void handleStartHunting(ActionEvent event) {
        // 1. Bring the emulator to focus (your original logic from main)
        try {
            Robot r = new Robot();
            r.mouseMove(1500, 100);
            r.mousePress(InputEvent.BUTTON1_DOWN_MASK);
            r.delay(100);
            r.mouseRelease(InputEvent.BUTTON1_DOWN_MASK);
            r.delay(500); // Give the emulator a moment to take focus
        } catch (AWTException e) {
            System.out.println("Could not focus emulator window.");
        }

        // 2. Declare the base class reference
        robotLoop activeBot;

        // 3. Instantiate the exact child variation based on the user's choice
        if (pokemonName.equalsIgnoreCase("Chikorita")) {
        	 chikoritaRobot chiko = new chikoritaRobot(this.filePath, this.pokedexNum, this.pokemonName);
             chiko.uiController = this; 
             activeBot = chiko;
         } else if (pokemonName.equalsIgnoreCase("Cyndaquil")) {
        	 cyndaquilRobot cynder = new cyndaquilRobot(this.filePath, this.pokedexNum, this.pokemonName);
             cynder.uiController = this; 
             activeBot = cynder;
         } else {
        	 totodileRobot toto = new totodileRobot(this.filePath, this.pokedexNum, this.pokemonName);
             toto.uiController = this; 
             activeBot = toto;
         }
         
        Thread botThread = new Thread(() -> {
            activeBot.normalLoop(); 
        });
        
        botThread.setDaemon(true); 
        botThread.start();
    }


	private void loadPokemonData() {

		if (pokemonName.equalsIgnoreCase("Cyndaquil")) {

			filePath = "cyndaquil.txt";

			pokedexNum = 155;

		} else if (pokemonName.equalsIgnoreCase("Chikorita")) {

			filePath = "chikorita.txt";

			pokedexNum = 152;
			
		} else if (pokemonName.equalsIgnoreCase("Totodile")) {

			filePath = "totodile.txt";

			pokedexNum = 158;
		}
		saveData.checkData(filePath);
		pokemonLabel.setText(pokemonName);
		encounterLabel.setText("Encounters: " + saveData.getEncounterCount());

		probabilityLabel.setText("Probability: " + String.format("%.2f", saveData.getProbabilityMessage()) + "%");
	}

	/**
	 * On action for the back button brings back the first scene to make a new
	 * choice
	 */
	public void backMain(ActionEvent e) throws IOException {

		Parent root = FXMLLoader.load(getClass().getResource("main.fxml"));

		Stage stage = (Stage) ((Node) e.getSource()).getScene().getWindow();

		Scene scene = new Scene(root);

		stage.setScene(scene);
		stage.show(); 
		
	}
	public void updateUiLabels() {

	    System.out.println("Updating UI to encounter: "
	            + saveData.getEncounterCount());

	    encounterLabel.setText(
	            "Encounters: " + saveData.getEncounterCount()
	    );

	    probabilityLabel.setText(
	            "Probability: "
	            + String.format("%.2f", saveData.getProbabilityMessage())
	            + "%"
	    );
	}
}
